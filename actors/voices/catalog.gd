    "house_muhammad_reply_2": {
      "start": 281.5965986394558,
      "duration": 1.6280272108843536,
      "text": "I'll let you get some rest."
    },
    "house_aisha_reply_2": {
      "start": 283.72462585034015,
      "duration": 1.709297052154195,
      "text": "I'll leave you in peace now."
