    "car_aisha_reply_0": {
      "start": 187.37079365079364,
      "duration": 2.231746031746032,
      "text": "I'll keep the speed down around people."
    },
    "car_musa_reply_0": {
      "start": 190.10253968253969,
      "duration": 2.50140589569161,
